# qi 运行时产物
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.python-version

# 运行时配置/数据(不入库;agent 样例在 examples/agents/)
.qi/

# 前端依赖与构建中间产物
ui/node_modules/
ui/dist/
ui/.vitest/

# 编辑器配置
.vscode/

# pi 自身的运行期目录(任务输出等,非源码)
.pi/

# 本地数据 / 参照仓库(deepseek-harness 等)
data/
sdk/

# 本地环境变量(示例见 .env.example)
.env
.env.local
.env.*.local
