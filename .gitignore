src/qi_agent/web/static/

# 已有忽略(参考组件)
sdk/
data/

# pi 自身的运行期目录(tasks 输出等,非源码)
.pi/

# qi-web 前端依赖与构建中间产物
extensions/qi-web/ui/node_modules/
extensions/qi-web/ui/dist/

# 编辑器配置
.vscode/

# vitest 缓存
web/.vitest/
