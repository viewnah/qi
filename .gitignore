# qi 运行时产物
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.python-version

# 运行时配置/数据(不入库;agent 样例在 examples/agents/)
.qi/

# qi-web 前端构建产物(generated:先 `cd web && npm run build` 再打包)
